{
  "manifest_version": 3,
  "name": "LokiSec - Web Security & Audit Toolkit",
  "version": "1.0.0",
  "description": "Loki-themed web security audit, passive reconnaissance, endpoint harvester, JWT analyzer, and AI security reviewer.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "cookies",
    "webRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "action": {
    "default_title": "LokiSec Audit Panel"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
